{
  "name": "dsh-ui-alt",
  "version": "0.2.13",
  "private": false,
  "type": "module",
  "description": "在保持原版 UI 大风格不变的情况下，进行减小圆角、紧凑化、秩序化、整洁化改进。使 UI 视觉更加冷静、专业、高效。多数改动可在设置中单独开关。",
  "license": "MIT",
  "author": "AomiRaku",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "ui",
    "compact"
  ],
  "homepage": "https://github.com/AomiRaku/dsh-ui-alt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AomiRaku/dsh-ui-alt.git"
  },
  "bugs": {
    "url": "https://github.com/AomiRaku/dsh-ui-alt/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
